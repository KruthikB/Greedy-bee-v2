{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greedy Bee",
  "version": "1.0.0",
  "identifier": "com.greedybee.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; img-src 'self' blob: data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "settings",
        "title": "Greedy Bee",
        "url": "settings/index.html",
        "width": 520,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "center": true,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
